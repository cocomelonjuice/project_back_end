DB_HOST=localhost
DB_PORT=5431
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=postgres
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
PORT=3000
NODE_ENV=development

# Groq (OpenAI-compatible API). Required for chat; never expose to frontend.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional override:
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Resend (welcome + password reset). Get key at https://resend.com
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev
FRONTEND_URL=http://localhost:5173
# Optional: reset link TTL in ms (default 3600000 = 1h)
# PASSWORD_RESET_EXPIRES_MS=3600000